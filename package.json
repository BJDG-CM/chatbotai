{
  "name": "chatbotai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cloudflare:dev": "vinext dev --port 3001",
    "cloudflare:build": "vinext build",
    "cloudflare:preview": "wrangler dev --config dist/server/wrangler.json",
    "cloudflare:deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cloudflare:typegen": "wrangler types --include-runtime false --env-interface CloudflareEnv worker-configuration.d.ts"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.23.0",
    "nanoid": "^5.1.16",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.2.8",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vinext": "^1.0.0-beta.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
