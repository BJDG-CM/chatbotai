{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatbotai",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "chatbot.yejunlee.com",
      "custom_domain": true
    }
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "LOGIN_GUARD", "class_name": "LoginGuard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoginGuard"] }],
  "cache": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "SITE_URL": "https://chatbot.yejunlee.com",
    "SITE_NAME": "Yejun's Private Chat",
    "ENABLE_FILE_HISTORY_BACKUP": "false",
    "CHAT_MAX_OUTPUT_TOKENS": "16384",
    "CHAT_EXTRA_MODEL_IDS": ""
  },
  "secrets": {
    "required": [
      "OPENROUTER_API_KEY",
      "CHATBOT_USERNAME",
      "CHATBOT_PASSWORD",
      "CHATBOT_SESSION_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
