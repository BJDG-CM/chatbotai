{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yejunlee-chatbot-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      "name": "yejunlee-chatbot-proxy-production",
      "routes": [
        {
          "pattern": "yejunlee.com/chatbot*",
          "zone_name": "yejunlee.com"
        }
      ],
      "vars": {
        "ORIGIN_HOST": "replace-with-your-vercel-project.vercel.app"
      }
    }
  }
}
